# ==========================================
# 数据库配置 (默认使用 SQLite 方便快速启动)
# 如果要切 PostgreSQL，示例：
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/contract_db
# ==========================================
DATABASE_URL=sqlite+aiosqlite:///./contract_review.db

# ==========================================
# 大模型配置 (必填，请替换为你自己的 Key)
# ==========================================
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ==========================================
# JWT 鉴权配置
# ==========================================
# 在生产环境中，请换成一长串随机字符串
JWT_SECRET_KEY=your-super-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440